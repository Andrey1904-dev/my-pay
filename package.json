{
  "name": "case-place-salary",
  "version": "1.1.3",
  "private": true,
  "description": "Моя смена — единое PWA для учёта смен, заработка, Supabase и Telegram",
  "type": "module",
  "scripts": {
    "start": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "npm run build:app && node scripts/copy-app-assets.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "node --test tests/*.test.mjs",
    "test:app": "node --test tests/app.test.mjs",
    "test:bot": "node --test tests/telegram-bot.test.mjs",
    "typecheck": "tsc -p supabase/functions/tsconfig.json",
    "typecheck:ui": "tsc -p tsconfig.json",
    "check": "npm run lint && node --check sw.js && npm run typecheck && npm run typecheck:ui && npm test",
    "build:app": "node scripts/build-app.mjs",
    "predev": "npm run build:app",
    "prestart": "npm run build:app",
    "pretest": "npm run build:app",
    "lint": "eslint src/app scripts sw.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {},
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@eslint/js": "^9.39.5",
    "@types/node": "22.19.17",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jsdom": "^25.0.1",
    "typescript": "5.9.3",
    "vite": "^7.3.7"
  }
}
